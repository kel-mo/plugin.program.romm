<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings version="1">
  <section id="plugin.program.romm">
    <category id="server" label="30100" help="">
      <group id="1">
        <setting id="server_url" type="string" label="30101" help="30102">
          <level>0</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30101</heading>
          </control>
        </setting>
        <setting id="pair" type="action" label="30103" help="30104">
          <level>0</level>
          <data>RunPlugin(plugin://plugin.program.romm/?action=pair)</data>
          <control type="button" format="action">
            <close>true</close>
          </control>
        </setting>
        <setting id="pair_code" type="action" label="30105" help="30106">
          <level>0</level>
          <data>RunPlugin(plugin://plugin.program.romm/?action=pair_code)</data>
          <control type="button" format="action">
            <close>true</close>
          </control>
        </setting>
        <setting id="signout" type="action" label="30107" help="">
          <level>0</level>
          <data>RunPlugin(plugin://plugin.program.romm/?action=signout)</data>
          <control type="button" format="action"/>
        </setting>
        <setting id="username" type="string" label="30108" help="">
          <level>0</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30108</heading>
          </control>
          <enable>false</enable>
