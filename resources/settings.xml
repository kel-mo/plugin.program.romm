      <group id="2">
        <setting id="token" type="string" label="" help="">
          <level>4</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading></heading>
            <hidden>true</hidden>
          </control>
          <visible>false</visible>
        </setting>
        <setting id="device_id" type="string" label="" help="">
          <level>4</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading></heading>
          </control>
          <visible>false</visible>
        </setting>
        <setting id="client_device_identifier" type="string" label="" help="">
          <level>4</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading></heading>
          </control>
          <visible>false</visible>
        </setting>
      </group>
    </category>
    <category id="playback" label="30200" help="">
      <group id="1">
        <setting id="pin_core" type="boolean" label="30201" help="30202">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="sync_bios" type="boolean" label="30203" help="30204">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="reset_cores" type="action" label="30205" help="30206">
          <level>0</level>
          <data>RunPlugin(plugin://plugin.program.romm/?action=reset_cores)</data>
          <control type="button" format="action"/>
        </setting>
      </group>
    </category>
    <category id="library" label="30300" help="">
      <group id="1">
        <setting id="page_size" type="integer" label="30301" help="">
          <level>1</level>
          <default>100</default>
          <constraints>
            <minimum>20</minimum>
            <step>20</step>
            <maximum>500</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="hide_unsupported" type="boolean" label="30302" help="30303">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="sort_by" type="string" label="30304" help="">
          <level>0</level>
          <default>name</default>
          <constraints>
            <options>
              <option label="30305">name</option>
              <option label="30306">first_release_date</option>
              <option label="30307">average_rating</option>
              <option label="30308">created_at</option>
              <option label="30309">last_played</option>
            </options>
          </constraints>
          <control type="list" format="string">
            <heading>30304</heading>
          </control>
        </setting>
      </group>
    </category>
    <category id="sync" label="30700" help="">
      <group id="1">
        <setting id="sync_saves" type="boolean" label="30701" help="30702">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="conflict_policy" type="string" label="30703" help="30704">
          <level>0</level>
          <default>newest</default>
          <constraints>
            <options>
              <option label="30705">newest</option>
              <option label="30706">server</option>
              <option label="30707">kodi</option>
            </options>
          </constraints>
          <dependencies>
            <dependency type="enable" setting="sync_saves">true</dependency>
          </dependencies>
          <control type="list" format="string">
            <heading>30703</heading>
          </control>
        </setting>
      </group>
      <group id="2">
        <setting id="report_play" type="boolean" label="30710" help="30711">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="sync_now" type="action" label="30712" help="30713">
          <level>0</level>
          <data>RunPlugin(plugin://plugin.program.romm/?action=sync_now)</data>
          <control type="button" format="action"/>
        </setting>
      </group>
    </category>
    <category id="cache" label="30400" help="">
      <group id="1">
        <setting id="cache_path" type="path" label="30401" help="30402">
          <level>0</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
            <writable>true</writable>
          </constraints>
          <control type="button" format="path">
            <heading>30401</heading>
          </control>
        </setting>
        <setting id="cache_limit_pct" type="integer" label="30403" help="30404">
          <level>0</level>
          <default>50</default>
          <constraints>
            <minimum>0</minimum>
            <step>5</step>
            <maximum>90</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
            <formatlabel>30405</formatlabel>
          </control>
        </setting>
        <setting id="clear_cache" type="action" label="30406" help="">
          <level>0</level>
          <data>RunPlugin(plugin://plugin.program.romm/?action=clear_cache)</data>
          <control type="button" format="action"/>
        </setting>
      </group>
    </category>
    <category id="advanced" label="30500" help="">
      <group id="1">
        <setting id="debug" type="boolean" label="30501" help="">
          <level>2</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
      </group>
    </category>
  </section>
</settings>
